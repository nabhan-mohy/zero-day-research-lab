# Zero-Day Research Lab Configuration

# Workspace
ZERODAYLAB_WORKSPACE=./workspace
ZERODAYLAB_STORAGE_PATH=./workspace/storage

# Logging
ZERODAYLAB_LOG_LEVEL=INFO
ZERODAYLAB_LOG_FILE=./logs/zerodaylab.log

# Fuzzing
ZERODAYLAB_DEFAULT_TIMEOUT=5
ZERODAYLAB_DEFAULT_MEMORY_LIMIT=2048
ZERODAYLAB_DEFAULT_WORKERS=4
ZERODAYLAB_MAX_INPUT_SIZE=65536

# Tool Paths (auto-detected if not set)
# AFL_PATH=/usr/local/bin/afl-fuzz
# CLANG_PATH=/usr/bin/clang
# GCC_PATH=/usr/bin/gcc

# Sanitizers
ZERODAYLAB_ASAN_ENABLED=true
ZERODAYLAB_UBSAN_ENABLED=true
ZERODAYLAB_LSAN_ENABLED=true
ZERODAYLAB_MSAN_ENABLED=false

# Security
ZERODAYLAB_ENABLE_SANDBOX=false
ZERODAYLAB_ENABLE_DOCKER=false

# Database
ZERODAYLAB_DATABASE_PATH=./workspace/zerodaylab.db
ZERODAYLAB_DATABASE_BACKUP_PATH=./workspace/backups
